{
  "name": "eslint-plugin-array-func",
  "version": "5.1.1",
  "description": "Rules dealing with Array functions and methods.",
  "license": "MIT",
  "repository": "github:freaktechnik/eslint-plugin-array-func",
  "bugs": "https://github.com/freaktechnik/eslint-plugin-array-func/issues",
  "author": "Martin Giger (https://humanoids.be)",
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": "^12.22.0 || ^14.17.0 || >=16.0.0"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "lint:js": "eslint index.js package.json rules/ test/",
    "lint": "npm run lint:js",
    "test": "npm run lint && c8 ava",
    "coverage": "c8 report --reporter lcov"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "rules/*.js"
  ],
  "keywords": [
    "eslint",
    "eslintplugin"
  ],
  "devDependencies": {
    "@freaktechnik/eslint-config-node": "^14.1.0",
    "@freaktechnik/eslint-config-test": "^14.1.0",
    "@typescript-eslint/parser": "^8.72.1",
    "ava": "^8.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-ava-rule-tester": "^5.0.1",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "eslint-plugin-optimize-regex": "^1.2.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": ">=8.51.0"
  },
  "nyc": {
    "reporter": [
      "lcov",
      "text"
    ]
  },
  "ava": {
    "files": [
      "test/**/*",
      "!test/helpers"
    ]
  }
}
